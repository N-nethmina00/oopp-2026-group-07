<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminController"
            styleClass="root">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="235" spacing="12" styleClass="sidebar">
            <padding>
                <Insets top="25" right="16" bottom="20" left="16"/>
            </padding>

            <Label text="AMS" styleClass="logo"/>
            <Label text="Academic Management"
                   styleClass="sidebar-subtitle"/>
            <Separator/>

            <Label text="MAIN MENU" styleClass="menu-heading"/>

            <Button text="Dashboard" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button active"/>
            <Button text="User Profiles" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Departments" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Batches" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Courses" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Timetable" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Notices" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Medical Approvals" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Reports" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>
            <Button text="My Profile" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Logout" onAction="#handleNavigation"
                    maxWidth="Infinity" styleClass="logout-button"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="22" styleClass="content">
            <padding>
                <Insets top="25" right="30" bottom="30" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox spacing="5">
                    <Label text="Admin Dashboard" styleClass="page-title"/>
                    <Label text="Welcome back! Here's your system overview."
                           styleClass="subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label text="ADMINISTRATOR" styleClass="admin-badge"/>
                    <Label text="Academic Management System"
                           styleClass="small-text"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- SUMMARY CARDS -->
            <HBox spacing="16" styleClass="stats-row">

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      styleClass="stat-card blue-card">
                    <Label text="TOTAL USERS" styleClass="stat-heading"/>
                    <Label fx:id="usersCount" text="0"
                           styleClass="stat-number"/>
                    <Label text="Registered system users"
                           styleClass="stat-description"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      styleClass="stat-card purple-card">
                    <Label text="TOTAL COURSES" styleClass="stat-heading"/>
                    <Label fx:id="coursesCount" text="0"
                           styleClass="stat-number"/>
                    <Label text="Available courses"
                           styleClass="stat-description"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      styleClass="stat-card green-card">
                    <Label text="DEPARTMENTS" styleClass="stat-heading"/>
                    <Label fx:id="departmentsCount" text="0"
                           styleClass="stat-number"/>
                    <Label text="Academic departments"
                           styleClass="stat-description"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS"
                      styleClass="stat-card orange-card">
                    <Label text="PENDING MEDICALS"
                           styleClass="stat-heading"/>
                    <Label fx:id="medicalsCount" text="0"
                           styleClass="stat-number"/>
                    <Label text="Awaiting approval"
                           styleClass="stat-description"/>
                </VBox>

            </HBox>

            <!-- QUICK ACTIONS -->
            <VBox spacing="14" styleClass="section-card">
                <Label text="Quick Actions" styleClass="section-title"/>
                <Label text="Quickly access common administration tasks."
                       styleClass="subtitle"/>

                <HBox spacing="12">
                    <Button text="+ Add User" onAction="#handleNavigation"
                            styleClass="action-button"/>
                    <Button text="+ Add Department" onAction="#handleNavigation"
                            styleClass="action-button"/>
                    <Button text="+ Add Course" onAction="#handleNavigation"
                            styleClass="action-button"/>
                    <Button text="View Reports" onAction="#handleNavigation"
                            styleClass="action-button"/>
                </HBox>
            </VBox>

            <!-- RECENT ACTIVITY -->
            <VBox spacing="14" styleClass="section-card"
                  VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Recent Activity"
                               styleClass="section-title"/>
                        <Label text="Latest actions recorded in the system."
                               styleClass="subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#refreshDashboard"
                            styleClass="refresh-button"/>
                </HBox>

                <TableView fx:id="activityTable"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="activityColumn"
                                     text="Activity" prefWidth="280"/>
                        <TableColumn fx:id="userColumn"
                                     text="User" prefWidth="150"/>
                        <TableColumn fx:id="dateColumn"
                                     text="Date / Time" prefWidth="180"/>
                        <TableColumn fx:id="statusColumn"
                                     text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <Label text="Academic Management System • Admin Panel"
                   styleClass="footer-text"/>

        </VBox>
    </center>

</BorderPane>
