<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane"
            minHeight="400"
            minWidth="600"
            prefHeight="680"
            prefWidth="1100"
            stylesheets="@../css/admin-dashboard.css"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminController">

   <top>
      <HBox alignment="CENTER_LEFT"
            prefHeight="70"
            spacing="12"
            style="-fx-background-color: #4C56CD;
                     -fx-background-radius: 0 0 18 18;">

         <padding>
            <Insets top="10"
                    right="20"
                    bottom="10"
                    left="20"/>
         </padding>

         <Label text="UMS"
                textFill="WHITE"
                style="-fx-font-size: 22px;
                          -fx-font-weight: bold;">
            <font>
               <Font name="System Bold" size="22"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         <VBox alignment="CENTER_RIGHT"
               spacing="3">

            <Label text="Welcome, Admin"
                   textFill="WHITE"
                   style="-fx-font-weight: bold;">
               <font>
                  <Font name="System Bold" size="13"/>
               </font>
            </Label>

            <Label text="Administrator"
                   textFill="#DCEEFF"/>
         </VBox>

         <StackPane minWidth="40"
                    minHeight="40"
                    prefWidth="40"
                    prefHeight="40">

            <Circle radius="19"
                    fill="WHITE"/>

            <Label text="A"
                   textFill="#4C56CD">
               <font>
                  <Font name="System Bold" size="18"/>
               </font>
            </Label>
         </StackPane>
      </HBox>
   </top>

   <left>
      <VBox prefWidth="185"
            spacing="10">

         <padding>
            <Insets top="18"
                    right="12"
                    bottom="15"
                    left="12"/>
         </padding>

         <VBox spacing="10"
               styleClass="admin-sidebar"
               VBox.vgrow="ALWAYS">

            <padding>
               <Insets top="18"
                       right="10"
                       bottom="15"
                       left="10"/>
            </padding>

            <Button fx:id="dashboardBtn"
                    text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button, selected"/>

            <Button fx:id="usersBtn"
                    text="Users"
                    onAction="#showUsers"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Button fx:id="coursesBtn"
                    text="Courses"
                    onAction="#showCourses"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Button fx:id="noticesBtn"
                    text="Notices"
                    onAction="#showNotices"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Button fx:id="timetablesBtn"
                    text="Time Tables"
                    onAction="#showTimetables"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Button fx:id="accountBtn"
                    text="Account"
                    onAction="#showAccount"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Log Out"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    prefHeight="38"
                    mnemonicParsing="false"
                    styleClass="logout-button"/>
         </VBox>
      </VBox>
   </left>

   <center>
      <ScrollPane fitToWidth="true"
                  hbarPolicy="NEVER"
                  vbarPolicy="AS_NEEDED"
                  minWidth="0"
                  style="-fx-background-color: transparent;
                           -fx-background: #F3F6FA;">

         <content>
            <VBox spacing="20"
                  minWidth="0"
                  fillWidth="true">

               <padding>
                  <Insets top="25"
                          right="22"
                          bottom="22"
                          left="10"/>
               </padding>

               <HBox alignment="CENTER_LEFT"
                     spacing="12">

                  <Label text="ADMIN DASHBOARD"
                         textFill="#17324D"
                         wrapText="true"
                         style="-fx-font-size: 24px;
                                      -fx-font-weight: bold;">
                     <font>
                        <Font name="System Bold" size="24"/>
                     </font>
                  </Label>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Button fx:id="btnRefresh"
                          text="Refresh"
                          onAction="#refreshDashboard"
                          mnemonicParsing="false"
                          prefHeight="34"
                          minWidth="75"
                          style="-fx-background-color: white;
                                       -fx-text-fill: #4C56CD;
                                       -fx-background-radius: 8;
                                       -fx-border-color: #4C56CD;
                                       -fx-border-radius: 8;
                                       -fx-cursor: hand;"/>
               </HBox>

               <GridPane hgap="14"
                         vgap="14"
                         minWidth="0">

                  <columnConstraints>
                     <ColumnConstraints percentWidth="50"
                                        minWidth="0"
                                        hgrow="ALWAYS"/>

                     <ColumnConstraints percentWidth="50"
                                        minWidth="0"
                                        hgrow="ALWAYS"/>
                  </columnConstraints>

                  <children>

                     <!-- Users -->
                     <VBox spacing="10"
                           prefHeight="125"
                           minWidth="0"
                           styleClass="stat-card"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0">

                        <Label text="Users"
                               styleClass="stat-heading"/>

                        <Label fx:id="lblUserCount"
                               text="—"
                               styleClass="stat-number"/>

                        <Label text="Registered users"
                               wrapText="true"
                               styleClass="stat-description"/>
                     </VBox>

                     <!-- Courses -->
                     <VBox spacing="10"
                           prefHeight="125"
                           minWidth="0"
                           styleClass="stat-card"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0">

                        <Label text="Courses"
                               styleClass="stat-heading"/>

                        <Label fx:id="lblCourseCount"
                               text="—"
                               styleClass="stat-number"/>

                        <Label text="Total courses"
                               wrapText="true"
                               styleClass="stat-description"/>
                     </VBox>

                     <!-- Notices -->
                     <VBox spacing="10"
                           prefHeight="125"
                           minWidth="0"
                           styleClass="stat-card"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1">

                        <Label text="Notices"
                               styleClass="stat-heading"/>

                        <Label fx:id="lblNoticeCount"
                               text="—"
                               styleClass="stat-number"/>

                        <Label text="Total notices"
                               wrapText="true"
                               styleClass="stat-description"/>
                     </VBox>

                     <!-- Timetable entries -->
                     <VBox spacing="10"
                           prefHeight="125"
                           minWidth="0"
                           styleClass="stat-card"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1">

                        <Label text="Timetable Entries"
                               wrapText="true"
                               styleClass="stat-heading"/>

                        <Label fx:id="lblTimetableCount"
                               text="—"
                               styleClass="stat-number"/>

                        <Label text="Scheduled timetable entries"
                               wrapText="true"
                               styleClass="stat-description"/>
                     </VBox>

                  </children>
               </GridPane>

               <Label fx:id="lblDashboardStatus"
                      text="Loading dashboard..."
                      wrapText="true"
                      maxWidth="Infinity"
                      textFill="#526174"/>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>