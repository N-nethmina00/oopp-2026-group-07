<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="450.0"
            minWidth="650.0"
            prefHeight="700.0"
            prefWidth="1050.0"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminNoticeManagementController">

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="18" left="20" right="20" top="20"/>
            </padding>

            <Label text="Notice Management" textFill="#17324D">
                <font>
                    <Font name="System Bold" size="20"/>
                </font>
            </Label>

            <Label text="Create, view, update and delete notices."
                   textFill="#7B8797">
                <font>
                    <Font size="11"/>
                </font>
            </Label>

            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #D5DCE5; -fx-border-radius: 5; -fx-border-width: 1;">
                <padding>
                    <Insets bottom="14" left="14" right="14" top="14"/>
                </padding>

                <Label text="Notice Details" textFill="#17324D">
                    <font>
                        <Font name="System Bold" size="13"/>
                    </font>
                </Label>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Notice ID" textFill="#526174"/>
                        <TextField fx:id="noticeIdField"
                                   editable="false"
                                   prefHeight="32"
                                   promptText="Auto generated"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Title" textFill="#526174"/>
                        <TextField fx:id="titleField"
                                   prefHeight="32"
                                   promptText="Enter notice title"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Published Date" textFill="#526174"/>
                        <DatePicker fx:id="publishedDatePicker"
                                    maxWidth="Infinity"
                                    prefHeight="32"
                                    promptText="Select published date"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Created Date" textFill="#526174"/>
                        <DatePicker fx:id="createdDatePicker"
                                    maxWidth="Infinity"
                                    prefHeight="32"
                                    promptText="Select created date"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Content" textFill="#526174"/>
                    <TextArea fx:id="contentArea"
                              prefHeight="75"
                              promptText="Enter notice content"
                              wrapText="true"/>
                </VBox>

                <HBox spacing="8">
                    <Button onAction="#handlePublish"
                            mnemonicParsing="false"
                            prefHeight="34"
                            style="-fx-background-color: #4c56cd; -fx-text-fill: white; -fx-background-radius: 5;"
                            text="Create Notice"/>

                    <Button onAction="#handleUpdate"
                            mnemonicParsing="false"
                            prefHeight="34"
                            style="-fx-background-color: #EEF0FF; -fx-text-fill: #4c56cd; -fx-background-radius: 5;"
                            text="Update"/>

                    <Button onAction="#handleDelete"
                            mnemonicParsing="false"
                            prefHeight="34"
                            style="-fx-background-color: #FCE8E8; -fx-text-fill: #B42318; -fx-background-radius: 5;"
                            text="Delete"/>

                    <Button onAction="#handleClear"
                            mnemonicParsing="false"
                            prefHeight="34"
                            style="-fx-background-color: #EEF0FF; -fx-text-fill: #4c56cd; -fx-background-radius: 5;"
                            text="Clear"/>
                </HBox>

                <Label fx:id="messageLabel"
                       wrapText="true"
                       textFill="#526174"/>
            </VBox>

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #D5DCE5; -fx-border-radius: 5; -fx-border-width: 1;">
                <padding>
                    <Insets bottom="12" left="12" right="12" top="12"/>
                </padding>

                <Label text="Notice List" textFill="#17324D">
                    <font>
                        <Font name="System Bold" size="13"/>
                    </font>
                </Label>

                <TableView fx:id="noticesTable"
                           prefHeight="280"
                           VBox.vgrow="ALWAYS"
                           style="-fx-font-size: 11;">
                    <columns>
                        <TableColumn fx:id="noticeIdColumn"
                                     prefWidth="85"
                                     text="Notice ID"/>

                        <TableColumn fx:id="titleColumn"
                                     prefWidth="180"
                                     text="Title"/>

                        <TableColumn fx:id="contentColumn"
                                     prefWidth="350"
                                     text="Content"/>

                        <TableColumn fx:id="publishedDateColumn"
                                     prefWidth="145"
                                     text="Published Date"/>

                        <TableColumn fx:id="createdDateColumn"
                                     prefWidth="145"
                                     text="Created Date"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
