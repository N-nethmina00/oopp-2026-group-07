<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="0.0"
            minWidth="0.0"
            prefHeight="700.0"
            prefWidth="1050.0"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminNoticeManagementController">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="false"
                    minWidth="0.0"
                    style="-fx-background-color: transparent;
                           -fx-background: #F3F6FA;
                           -fx-padding: 0;">

            <content>
                <VBox spacing="18.0"
                      fillWidth="true"
                      minWidth="0.0"
                      style="-fx-background-color: #F3F6FA;">

                    <padding>
                        <Insets top="24.0"
                                right="24.0"
                                bottom="24.0"
                                left="24.0"/>
                    </padding>

                    <!-- Page heading -->
                    <VBox spacing="6.0">
                        <Label text="Notice Management"
                               textFill="#12346B"
                               wrapText="true"
                               style="-fx-font-family: 'System';
                                      -fx-font-size: 34px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #12346B;">
                            <font>
                                <Font name="System Bold" size="34.0"/>
                            </font>
                        </Label>

                        <Label text="Create, view, update and delete notices."
                               textFill="#7B8797"
                               wrapText="true"/>
                    </VBox>

                    <!-- Notice form -->
                    <VBox spacing="16.0"
                          minHeight="-Infinity"
                          minWidth="0.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">

                        <padding>
                            <Insets top="20.0"
                                    right="20.0"
                                    bottom="20.0"
                                    left="20.0"/>
                        </padding>

                        <Label text="Notice Details"
                               textFill="#17324D">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Label>

                        <GridPane hgap="16.0"
                                  vgap="16.0"
                                  minWidth="0.0">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"
                                                   minWidth="0.0"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="50.0"
                                                   minWidth="0.0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7.0"
                                      minWidth="0.0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">

                                    <Label text="Notice ID"
                                           textFill="#526174"/>

                                    <TextField fx:id="noticeIdField"
                                               editable="false"
                                               focusTraversable="false"
                                               minWidth="0.0"
                                               maxWidth="Infinity"
                                               prefHeight="38.0"
                                               promptText="Auto generated"
                                               style="-fx-background-color: #F1F5F9;
                                                      -fx-text-fill: #64748B;"/>
                                </VBox>

                                <VBox spacing="7.0"
                                      minWidth="0.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">

                                    <Label text="Title"
                                           textFill="#526174"/>

                                    <TextField fx:id="titleField"
                                               minWidth="0.0"
                                               maxWidth="Infinity"
                                               prefHeight="38.0"
                                               promptText="Enter notice title"/>
                                </VBox>

                                <VBox spacing="7.0"
                                      minWidth="0.0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">

                                    <Label text="Published Date"
                                           textFill="#526174"/>

                                    <DatePicker fx:id="publishedDatePicker"
                                                minWidth="0.0"
                                                maxWidth="Infinity"
                                                prefHeight="38.0"
                                                promptText="Select published date"/>
                                </VBox>

                                <VBox spacing="7.0"
                                      minWidth="0.0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">

                                    <Label text="Created Date"
                                           textFill="#526174"/>

                                    <DatePicker fx:id="createdDatePicker"
                                                minWidth="0.0"
                                                maxWidth="Infinity"
                                                prefHeight="38.0"
                                                promptText="Select created date"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <VBox spacing="7.0"
                              minWidth="0.0">

                            <Label text="Content"
                                   textFill="#526174"/>

                            <TextArea fx:id="contentArea"
                                      minWidth="0.0"
                                      minHeight="120.0"
                                      prefHeight="140.0"
                                      maxWidth="Infinity"
                                      promptText="Enter notice content"
                                      wrapText="true"/>
                        </VBox>

                        <FlowPane alignment="CENTER_LEFT"
                                  hgap="10.0"
                                  vgap="10.0">

                            <Button text="Create Notice"
                                    onAction="#handlePublish"
                                    mnemonicParsing="false"
                                    minWidth="120.0"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #4c56cd;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Update"
                                    onAction="#handleUpdate"
                                    mnemonicParsing="false"
                                    minWidth="90.0"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4c56cd;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Delete"
                                    onAction="#handleDelete"
                                    mnemonicParsing="false"
                                    minWidth="90.0"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #FCE8E8;
                                           -fx-text-fill: #B42318;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Clear"
                                    onAction="#handleClear"
                                    mnemonicParsing="false"
                                    minWidth="90.0"
                                    prefHeight="38.0"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4c56cd;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>
                        </FlowPane>

                        <Label fx:id="messageLabel"
                               minHeight="-Infinity"
                               maxWidth="Infinity"
                               wrapText="true"
                               textFill="#526174"/>
                    </VBox>

                    <!-- Notice list -->
                    <VBox spacing="14.0"
                          minHeight="-Infinity"
                          minWidth="0.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;">

                        <padding>
                            <Insets top="20.0"
                                    right="20.0"
                                    bottom="20.0"
                                    left="20.0"/>
                        </padding>

                        <Label text="Notice List"
                               textFill="#17324D">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Label>

                        <TableView fx:id="noticesTable"
                                   fixedCellSize="38.0"
                                   minHeight="-Infinity"
                                   maxHeight="-Infinity"
                                   prefHeight="260.0"
                                   minWidth="0.0"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 11px;
                                          -fx-background-color: white;
                                          -fx-border-color: #E2E8F0;
                                          -fx-background-radius: 7;
                                          -fx-border-radius: 7;
                                          -fx-padding: 0;">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <placeholder>
                                <Label text="No notices available."
                                       textFill="#7B8797"/>
                            </placeholder>

                            <columns>
                                <TableColumn fx:id="noticeIdColumn"
                                             text="Notice ID"
                                             minWidth="65.0"
                                             prefWidth="85.0"/>

                                <TableColumn fx:id="titleColumn"
                                             text="Title"
                                             minWidth="90.0"
                                             prefWidth="180.0"/>

                                <TableColumn fx:id="contentColumn"
                                             text="Content"
                                             minWidth="100.0"
                                             prefWidth="350.0"/>

                                <TableColumn fx:id="publishedDateColumn"
                                             text="Published Date"
                                             minWidth="105.0"
                                             prefWidth="145.0"/>

                                <TableColumn fx:id="createdDateColumn"
                                             text="Created Date"
                                             minWidth="105.0"
                                             prefWidth="145.0"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>