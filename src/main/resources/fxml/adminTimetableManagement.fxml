<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="0.0"
            minWidth="0.0"
            prefHeight="720.0"
            prefWidth="1100.0"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminTimetableManagementController">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="false"
                    minWidth="0.0"
                    style="-fx-background-color: transparent;
                           -fx-background: #F3F6FA;
                           -fx-padding: 0;">

            <content>
                <VBox spacing="18.0"
                      minWidth="0.0"
                      fillWidth="true"
                      style="-fx-background-color: #F3F6FA;">

                    <padding>
                        <Insets top="24"
                                right="24"
                                bottom="24"
                                left="24"/>
                    </padding>

                    <VBox spacing="6">
                        <Label text="Timetable Management"
                               textFill="#12346B"
                               wrapText="true"
                               style="-fx-font-family: 'System';
                                      -fx-font-size: 34px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #12346B;">
                            <font>
                                <Font name="System Bold"
                                      size="34"/>
                            </font>
                        </Label>

                        <Label text="Add, view, update and delete timetable entries."
                               textFill="#7B8797"
                               wrapText="true"/>
                    </VBox>

                    <VBox spacing="16"
                          minWidth="0"
                          minHeight="-Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Timetable Details"
                               textFill="#17324D">
                            <font>
                                <Font name="System Bold"
                                      size="16"/>
                            </font>
                        </Label>

                        <GridPane hgap="14"
                                  vgap="16"
                                  minWidth="0">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="30"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="40"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="30"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">

                                    <Label text="Entry ID"
                                           textFill="#526174"/>

                                    <TextField fx:id="entryIdField"
                                               editable="false"
                                               focusTraversable="false"
                                               promptText="Auto-generated"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"
                                               style="-fx-background-color: #F1F5F9;
                                                      -fx-text-fill: #64748B;"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">

                                    <Label text="Course"
                                           textFill="#526174"/>

                                    <ComboBox fx:id="courseComboBox"
                                              promptText="Select course"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"
                                              visibleRowCount="8"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="0">

                                    <Label text="Day"
                                           textFill="#526174"/>

                                    <ComboBox fx:id="dayComboBox"
                                              promptText="Select day"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">

                                    <Label text="Start Time (24-hour)"
                                           wrapText="true"
                                           textFill="#526174"/>

                                    <TextField fx:id="startTimeField"
                                               promptText="08:30"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">

                                    <Label text="End Time (24-hour)"
                                           wrapText="true"
                                           textFill="#526174"/>

                                    <TextField fx:id="endTimeField"
                                               promptText="10:30"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="1">

                                    <Label text="Venue / Lecture Hall"
                                           wrapText="true"
                                           textFill="#526174"/>

                                    <TextField fx:id="venueField"
                                               promptText="Example: ICT Lab 11"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="2">

                                    <Label text="Session Type"
                                           textFill="#526174"/>

                                    <ComboBox fx:id="sessionTypeComboBox"
                                              promptText="Select type"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="2">

                                    <Label text="Academic Year"
                                           textFill="#526174"/>

                                    <ComboBox fx:id="academicYearComboBox"
                                              promptText="Select academic year"
                                              editable="false"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="2"
                                      GridPane.rowIndex="2">

                                    <Label text="Semester"
                                           textFill="#526174"/>

                                    <ComboBox fx:id="semesterComboBox"
                                              promptText="Select semester"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <Label text="IDs are assigned automatically from the highest saved ID. Select an academic year and semester. Use HH:mm times. Overlapping subjects on the same day, academic year and semester are blocked, including different venues. Back-to-back sessions are allowed."
                               wrapText="true"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #64748B;"/>

                        <FlowPane hgap="10"
                                  vgap="10"
                                  alignment="CENTER_LEFT">

                            <Button text="Add Entry"
                                    onAction="#handleAdd"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="100"
                                    style="-fx-background-color: #4c56cd;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Update"
                                    onAction="#handleUpdate"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4c56cd;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Delete"
                                    onAction="#handleDelete"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #FCE8E8;
                                           -fx-text-fill: #B42318;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>

                            <Button text="Clear"
                                    onAction="#handleClear"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4c56cd;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 16;
                                           -fx-cursor: hand;"/>
                        </FlowPane>

                        <Label fx:id="messageLabel"
                               wrapText="true"
                               minHeight="-Infinity"
                               maxWidth="Infinity"
                               textFill="#526174"/>
                    </VBox>

                    <VBox spacing="14"
                          minWidth="0"
                          minHeight="-Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label text="Timetable List"
                               textFill="#17324D">
                            <font>
                                <Font name="System Bold"
                                      size="16"/>
                            </font>
                        </Label>

                        <TableView fx:id="timetableTable"
                                   fixedCellSize="38"
                                   minHeight="-Infinity"
                                   maxHeight="-Infinity"
                                   prefHeight="260"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 11px;
                                          -fx-background-color: white;
                                          -fx-border-color: #E2E8F0;
                                          -fx-background-radius: 7;
                                          -fx-border-radius: 7;
                                          -fx-padding: 0;">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <placeholder>
                                <Label text="No timetable entries available."
                                       textFill="#7B8797"/>
                            </placeholder>

                            <columns>
                                <TableColumn fx:id="entryIdColumn"
                                             text="Entry ID"
                                             minWidth="45"
                                             prefWidth="65"/>

                                <TableColumn fx:id="courseColumn"
                                             text="Course Code"
                                             minWidth="65"
                                             prefWidth="100"/>

                                <TableColumn fx:id="dayColumn"
                                             text="Day"
                                             minWidth="60"
                                             prefWidth="90"/>

                                <TableColumn fx:id="timeColumn"
                                             text="Time"
                                             minWidth="90"
                                             prefWidth="120"/>

                                <TableColumn fx:id="venueColumn"
                                             text="Venue"
                                             minWidth="55"
                                             prefWidth="95"/>

                                <TableColumn fx:id="sessionTypeColumn"
                                             text="Session"
                                             minWidth="60"
                                             prefWidth="85"/>

                                <TableColumn fx:id="yearColumn"
                                             text="Academic Year"
                                             minWidth="80"
                                             prefWidth="110"/>

                                <TableColumn fx:id="semesterColumn"
                                             text="Semester"
                                             minWidth="70"
                                             prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>