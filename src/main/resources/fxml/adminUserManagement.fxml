<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminUserManagementController"
            stylesheets="@../css/admin-users.css"
            styleClass="user-management"
            minWidth="0"
            minHeight="0"
            prefWidth="1100"
            prefHeight="700">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="page-scroll">

            <content>
                <VBox spacing="18" minWidth="0" fillWidth="true">

                    <padding>
                        <Insets top="24" right="24"
                                bottom="24" left="24"/>
                    </padding>

                    <VBox spacing="5">
                        <Label text="User Profile Management"
                               wrapText="true"
                               styleClass="page-title"/>

                        <Label text="Select a role first. User ID and role-specific ID are generated automatically."
                               wrapText="true"
                               styleClass="muted"/>
                    </VBox>

                    <VBox spacing="16"
                          minHeight="-Infinity"
                          styleClass="card">

                        <padding>
                            <Insets top="20" right="20"
                                    bottom="20" left="20"/>
                        </padding>

                        <Label fx:id="modeLabel"
                               text="Create User"
                               styleClass="section-title"/>

                        <GridPane hgap="16" vgap="16" minWidth="0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="34"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="0">
                                    <Label text="Role *"
                                           styleClass="field-label"/>

                                    <ComboBox fx:id="roleComboBox"
                                              promptText="Select role first"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              minHeight="38"
                                              prefHeight="38"
                                              maxHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="1">
                                    <Label text="User ID"
                                           styleClass="field-label"/>

                                    <TextField fx:id="userIdField"
                                               promptText="Generated automatically"
                                               editable="false"
                                               styleClass="auto-id"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               minHeight="38"
                                               prefHeight="38"
                                               maxHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="2">
                                    <Label fx:id="roleSpecificIdLabel"
                                           text="Role-specific ID"
                                           wrapText="true"
                                           styleClass="field-label"/>

                                    <TextField fx:id="roleSpecificIdField"
                                               promptText="Generated automatically"
                                               editable="false"
                                               styleClass="auto-id"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               minHeight="38"
                                               prefHeight="38"
                                               maxHeight="38"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <Label fx:id="idHintLabel"
                               text="Select a role to generate IDs."
                               wrapText="true"
                               styleClass="id-hint"/>

                        <Separator/>

                        <VBox fx:id="detailsBox"
                              spacing="16"
                              disable="true">

                            <GridPane hgap="16"
                                      vgap="16"
                                      minWidth="0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="34"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                </columnConstraints>

                                <children>
                                    <VBox fx:id="departmentBox"
                                          spacing="7"
                                          minWidth="0"
                                          visible="false"
                                          managed="false"
                                          GridPane.columnIndex="0"
                                          GridPane.valignment="TOP">

                                        <Label text="Department *"
                                               styleClass="field-label"/>

                                        <ComboBox fx:id="departmentComboBox"
                                                  promptText="Select department"
                                                  minWidth="0"
                                                  maxWidth="Infinity"
                                                  minHeight="38"
                                                  prefHeight="38"
                                                  maxHeight="38"
                                                  visibleRowCount="8"/>

                                        <Label text="Required for Lecturer, Undergraduate and Technical Officer accounts."
                                               wrapText="true"
                                               styleClass="muted"/>
                                    </VBox>

                                    <VBox fx:id="batchBox"
                                          spacing="7"
                                          minWidth="0"
                                          visible="false"
                                          managed="false"
                                          GridPane.columnIndex="1"
                                          GridPane.valignment="TOP">

                                        <Label text="Batch *"
                                               styleClass="field-label"/>

                                        <ComboBox fx:id="batchComboBox"
                                                  promptText="Select undergraduate batch"
                                                  minWidth="0"
                                                  maxWidth="Infinity"
                                                  minHeight="38"
                                                  prefHeight="38"
                                                  maxHeight="38"
                                                  visibleRowCount="8"/>
                                    </VBox>
                                </children>
                            </GridPane>

                            <GridPane hgap="16" vgap="16" minWidth="0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="34"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                </columnConstraints>

                                <children>
                                    <VBox spacing="7" minWidth="0"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="0">
                                        <Label text="Username *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="usernameField"
                                                   promptText="Enter username"
                                                   minWidth="0"
                                                   maxWidth="Infinity"
                                                   minHeight="38"
                                                   prefHeight="38"
                                                   maxHeight="38"/>
                                    </VBox>

                                    <VBox spacing="7" minWidth="0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="0">
                                        <Label text="Password"
                                               styleClass="field-label"/>

                                        <PasswordField fx:id="passwordField"
                                                       promptText="At least 8 characters"
                                                       minWidth="0"
                                                       maxWidth="Infinity"
                                                       minHeight="38"
                                                       prefHeight="38"
                                                       maxHeight="38"/>
                                    </VBox>

                                    <VBox spacing="7" minWidth="0"
                                          GridPane.columnIndex="2"
                                          GridPane.rowIndex="0">
                                        <Label text="Email *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="emailField"
                                                   promptText="name@example.com"
                                                   minWidth="0"
                                                   maxWidth="Infinity"
                                                   minHeight="38"
                                                   prefHeight="38"
                                                   maxHeight="38"/>
                                    </VBox>

                                    <VBox spacing="7" minWidth="0"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="1">
                                        <Label text="First Name *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="firstNameField"
                                                   promptText="Enter first name"
                                                   minWidth="0"
                                                   maxWidth="Infinity"
                                                   minHeight="38"
                                                   prefHeight="38"
                                                   maxHeight="38"/>
                                    </VBox>

                                    <VBox spacing="7" minWidth="0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="1">
                                        <Label text="Last Name *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="lastNameField"
                                                   promptText="Enter last name"
                                                   minWidth="0"
                                                   maxWidth="Infinity"
                                                   minHeight="38"
                                                   prefHeight="38"
                                                   maxHeight="38"/>
                                    </VBox>
                                </children>
                            </GridPane>

                            <Label text="Use 8 to 255 characters for a new password. When updating, leave it empty to keep the current password."
                                   wrapText="true"
                                   styleClass="muted"/>
                        </VBox>

                        <FlowPane hgap="13" vgap="10">

                            <Button fx:id="addButton"
                                    text="Add User"
                                    onAction="#addUser"
                                    mnemonicParsing="false"
                                    prefWidth="138"
                                    prefHeight="49"
                                    disable="true"
                                    style="-fx-background-color: #4F50D2;
                                           -fx-text-fill: white;
                                           -fx-font-size: 14px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 9;
                                           -fx-padding: 12 20;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="updateButton"
                                    text="Update"
                                    onAction="#updateUser"
                                    mnemonicParsing="false"
                                    prefWidth="113"
                                    prefHeight="49"
                                    disable="true"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4F50D2;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 9;
                                           -fx-padding: 12 20;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="deleteButton"
                                    text="Delete"
                                    onAction="#deleteUser"
                                    mnemonicParsing="false"
                                    prefWidth="113"
                                    prefHeight="49"
                                    disable="true"
                                    style="-fx-background-color: #FCE8E8;
                                           -fx-text-fill: #B42318;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 9;
                                           -fx-padding: 12 20;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="clearButton"
                                    text="Clear"
                                    onAction="#clearFields"
                                    mnemonicParsing="false"
                                    prefWidth="113"
                                    prefHeight="49"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4F50D2;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 9;
                                           -fx-padding: 12 20;
                                           -fx-cursor: hand;"/>

                            <Button fx:id="refreshButton"
                                    text="Refresh"
                                    onAction="#refreshUsers"
                                    mnemonicParsing="false"
                                    prefWidth="113"
                                    prefHeight="49"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4F50D2;
                                           -fx-font-size: 14px;
                                           -fx-background-radius: 9;
                                           -fx-padding: 12 20;
                                           -fx-cursor: hand;"/>
                        </FlowPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ProgressIndicator fx:id="progressIndicator"
                                               prefWidth="20"
                                               prefHeight="20"
                                               maxWidth="20"
                                               maxHeight="20"
                                               visible="false"
                                               managed="false"/>

                            <Label fx:id="messageLabel"
                                   wrapText="true"
                                   styleClass="message"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14"
                          minHeight="-Infinity"
                          styleClass="card">

                        <padding>
                            <Insets top="20" right="20"
                                    bottom="20" left="20"/>
                        </padding>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Registered Users"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="countLabel"
                                   text="0 users"
                                   styleClass="count-label"/>
                        </HBox>

                        <TextField fx:id="searchField"
                                   promptText="Search by ID, name, username, email, role or department..."
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   prefHeight="38"/>

                        <TableView fx:id="usersTable"
                                   prefHeight="360"
                                   minHeight="200"
                                   minWidth="0"
                                   fixedCellSize="40">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="userIdColumn"
                                             text="User ID"
                                             minWidth="55"
                                             prefWidth="75"/>

                                <TableColumn fx:id="roleSpecificIdColumn"
                                             text="Role / Reg. ID"
                                             minWidth="75"
                                             prefWidth="100"/>

                                <TableColumn fx:id="usernameColumn"
                                             text="Username"
                                             minWidth="75"
                                             prefWidth="110"/>

                                <TableColumn fx:id="fullNameColumn"
                                             text="Full Name"
                                             minWidth="90"
                                             prefWidth="150"/>

                                <TableColumn fx:id="emailColumn"
                                             text="Email"
                                             minWidth="100"
                                             prefWidth="180"/>

                                <TableColumn fx:id="roleColumn"
                                             text="Role"
                                             minWidth="85"
                                             prefWidth="130"/>

                                <TableColumn fx:id="departmentColumn"
                                             text="Department"
                                             minWidth="100"
                                             prefWidth="180"/>
                            </columns>

                            <placeholder>
                                <Label text="Loading users..."/>
                            </placeholder>
                        </TableView>

                        <Label text="Select a row to edit. Department, batch, role and existing IDs are preserved when updating."
                               wrapText="true"
                               styleClass="muted"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>