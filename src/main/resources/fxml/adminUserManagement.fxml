<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="0"
            minWidth="0"
            prefHeight="700"
            prefWidth="1100"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminUserManagementController">

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="false"
                    minWidth="0"
                    style="-fx-background-color: transparent;
                           -fx-background: #F3F6FA;
                           -fx-padding: 0;">

            <content>
                <VBox spacing="18"
                      minWidth="0"
                      fillWidth="true"
                      style="-fx-background-color: #F3F6FA;">

                    <padding>
                        <Insets top="24" right="24"
                                bottom="24" left="24"/>
                    </padding>

                    <VBox spacing="6">
                        <Label text="User Profile Management"
                               wrapText="true"
                               style="-fx-font-size: 24px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #17324D;"/>

                        <Label text="Manage users and their role-specific IDs."
                               wrapText="true"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #7B8797;"/>
                    </VBox>

                    <!-- User form -->
                    <VBox spacing="16"
                          minWidth="0"
                          minHeight="-Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20" right="20"
                                    bottom="20" left="20"/>
                        </padding>

                        <Label text="User Details"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #17324D;"/>

                        <!-- ID and role fields -->
                        <GridPane hgap="14" vgap="16" minWidth="0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="34"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="0">
                                    <Label text="User ID"
                                           textFill="#526174"/>
                                    <TextField fx:id="userIdField"
                                               promptText="Enter user ID"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="1">
                                    <Label fx:id="roleSpecificIdLabel"
                                           text="Role-specific ID"
                                           wrapText="true"
                                           textFill="#526174"/>
                                    <TextField fx:id="roleSpecificIdField"
                                               promptText="Enter role-specific ID"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="2">
                                    <Label text="Role"
                                           textFill="#526174"/>
                                    <ComboBox fx:id="roleComboBox"
                                              promptText="Select role"
                                              minWidth="0"
                                              maxWidth="Infinity"
                                              prefHeight="38"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- Login fields -->
                        <GridPane hgap="14" minWidth="0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="0">
                                    <Label text="Username"
                                           textFill="#526174"/>
                                    <TextField fx:id="usernameField"
                                               promptText="Enter username"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="1">
                                    <Label text="Password"
                                           textFill="#526174"/>
                                    <PasswordField fx:id="passwordField"
                                                   promptText="Enter password"
                                                   minWidth="0"
                                                   maxWidth="Infinity"
                                                   prefHeight="38"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <Label text="Password is required for new users. Leave it blank when updating to keep the current password."
                               wrapText="true"
                               maxWidth="Infinity"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #7B8797;"/>

                        <!-- Personal information -->
                        <GridPane hgap="14" minWidth="0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="40"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="0">
                                    <Label text="First Name"
                                           textFill="#526174"/>
                                    <TextField fx:id="firstNameField"
                                               promptText="Enter first name"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="1">
                                    <Label text="Last Name"
                                           textFill="#526174"/>
                                    <TextField fx:id="lastNameField"
                                               promptText="Enter last name"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>

                                <VBox spacing="7" minWidth="0"
                                      GridPane.columnIndex="2">
                                    <Label text="Email"
                                           textFill="#526174"/>
                                    <TextField fx:id="emailField"
                                               promptText="Enter email"
                                               minWidth="0"
                                               maxWidth="Infinity"
                                               prefHeight="38"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- Buttons wrap when space is limited -->
                        <FlowPane hgap="10" vgap="10"
                                  alignment="CENTER_LEFT">

                            <Button text="Add User"
                                    onAction="#addUser"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="100"
                                    style="-fx-background-color: #4C56CD;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>

                            <Button text="Update"
                                    onAction="#updateUser"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #EEF0FF;
                                           -fx-text-fill: #4C56CD;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>

                            <Button text="Delete"
                                    onAction="#deleteUser"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #FFF0F0;
                                           -fx-text-fill: #D64545;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>

                            <Button text="Clear"
                                    onAction="#clearFields"
                                    mnemonicParsing="false"
                                    prefHeight="38"
                                    minWidth="90"
                                    style="-fx-background-color: #EEF2F6;
                                           -fx-text-fill: #526174;
                                           -fx-background-radius: 7;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>
                        </FlowPane>
                    </VBox>

                    <!-- Registered users -->
                    <VBox spacing="14"
                          minWidth="0"
                          minHeight="-Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #D5DCE5;
                                 -fx-border-radius: 12;">

                        <padding>
                            <Insets top="20" right="20"
                                    bottom="20" left="20"/>
                        </padding>

                        <Label text="Registered Users"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #17324D;"/>

                        <TableView fx:id="usersTable"
                                   fixedCellSize="38"
                                   minHeight="-Infinity"
                                   maxHeight="-Infinity"
                                   prefHeight="260"
                                   minWidth="0"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 11px;
                                          -fx-background-color: white;
                                          -fx-border-color: #E2E8F0;
                                          -fx-background-radius: 7;
                                          -fx-border-radius: 7;
                                          -fx-padding: 0;">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <placeholder>
                                <Label text="No registered users available."
                                       textFill="#7B8797"/>
                            </placeholder>

                            <columns>
                                <TableColumn fx:id="userIdColumn"
                                             text="User ID"
                                             minWidth="55"
                                             prefWidth="100"/>

                                <TableColumn fx:id="roleSpecificIdColumn"
                                             text="Role ID"
                                             minWidth="60"
                                             prefWidth="130"/>

                                <TableColumn fx:id="usernameColumn"
                                             text="Username"
                                             minWidth="75"
                                             prefWidth="130"/>

                                <TableColumn fx:id="fullNameColumn"
                                             text="Full Name"
                                             minWidth="90"
                                             prefWidth="180"/>

                                <TableColumn fx:id="emailColumn"
                                             text="Email"
                                             minWidth="100"
                                             prefWidth="220"/>

                                <TableColumn fx:id="roleColumn"
                                             text="Role"
                                             minWidth="85"
                                             prefWidth="160"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>