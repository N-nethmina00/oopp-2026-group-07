<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="400.0"
            minWidth="600.0"
            prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminUserManagementController">

    <center>
        <VBox spacing="14" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>

            <Label text="User Profile Management"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #17324D;"/>

            <Label text="Manage users and their role-specific IDs"
                   style="-fx-font-size: 13px; -fx-text-fill: #7B8797;"/>

            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #D5DCE5; -fx-border-radius: 10;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label text="User Details"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #17324D;"/>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="User ID"/>
                        <TextField fx:id="userIdField" promptText="Enter user ID"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="roleSpecificIdLabel" text="Role-specific ID"/>
                        <TextField fx:id="roleSpecificIdField" promptText="Enter role-specific ID"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Role"/>
                        <ComboBox fx:id="roleComboBox"
                                  promptText="Select role"
                                  maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Username"/>
                        <TextField fx:id="usernameField" promptText="Enter username"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Password"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Required for new users; optional for updates"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="First Name"/>
                        <TextField fx:id="firstNameField" promptText="Enter first name"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Last Name"/>
                        <TextField fx:id="lastNameField" promptText="Enter last name"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Email"/>
                        <TextField fx:id="emailField" promptText="Enter email"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button text="Add User"
                            onAction="#addUser"
                            style="-fx-background-color: #4C56CD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 9 18;"/>

                    <Button text="Update"
                            onAction="#updateUser"
                            style="-fx-background-color: #EEF0FF; -fx-text-fill: #4C56CD; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 9 18;"/>

                    <Button text="Delete"
                            onAction="#deleteUser"
                            style="-fx-background-color: #FFF0F0; -fx-text-fill: #D64545; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 9 18;"/>

                    <Button text="Clear"
                            onAction="#clearFields"
                            style="-fx-background-color: #EEF2F6; -fx-text-fill: #526174; -fx-background-radius: 5; -fx-padding: 9 18;"/>
                </HBox>
            </VBox>

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #D5DCE5; -fx-border-radius: 10;">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="Registered Users"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #17324D;"/>

                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="100"/>
                        <TableColumn fx:id="roleSpecificIdColumn" text="Role ID" prefWidth="130"/>
                        <TableColumn fx:id="usernameColumn" text="Username" prefWidth="130"/>
                        <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="180"/>
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="roleColumn" text="Role" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>