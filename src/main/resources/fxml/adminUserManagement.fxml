<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.AdminUserManagementController"
            stylesheets="@/css/admin-users.css"
            styleClass="user-management"
            minWidth="0"
            minHeight="0"
            prefWidth="1100"
            prefHeight="700">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="page-scroll">

            <content>
                <VBox spacing="18" minWidth="0" fillWidth="true">

                    <padding>
                        <Insets top="22"
                                right="22"
                                bottom="22"
                                left="22"/>
                    </padding>

                    <VBox spacing="5">
                        <Label text="User Profile Management"
                               styleClass="page-title"/>

                        <Label text="Select a role first. User ID and role-specific ID are generated automatically."
                               wrapText="true"
                               styleClass="muted"/>
                    </VBox>

                    <VBox spacing="16"
                          minHeight="-Infinity"
                          styleClass="card">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <Label fx:id="modeLabel"
                               text="Create User"
                               styleClass="section-title"/>

                        <!-- Role is the first field. -->
                        <GridPane hgap="14" vgap="12" minWidth="0">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="34"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="33"
                                                   minWidth="0"
                                                   hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="0">

                                    <Label text="1. Select Role *"
                                           styleClass="field-label"/>

                                    <ComboBox fx:id="roleComboBox"
                                              promptText="Select role first"
                                              maxWidth="Infinity"
                                              minWidth="0"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="1">

                                    <Label text="2. User ID"
                                           styleClass="field-label"/>

                                    <TextField fx:id="userIdField"
                                               promptText="Generated automatically"
                                               editable="false"
                                               minWidth="0"
                                               styleClass="auto-id"/>
                                </VBox>

                                <VBox spacing="7"
                                      minWidth="0"
                                      GridPane.columnIndex="2">

                                    <Label fx:id="roleSpecificIdLabel"
                                           text="Role-specific ID"
                                           styleClass="field-label"/>

                                    <TextField fx:id="roleSpecificIdField"
                                               promptText="Generated automatically"
                                               editable="false"
                                               minWidth="0"
                                               styleClass="auto-id"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <Label fx:id="idHintLabel"
                               text="Select a role to generate IDs."
                               wrapText="true"
                               styleClass="id-hint"/>

                        <Separator/>

                        <VBox fx:id="detailsBox"
                              spacing="14"
                              disable="true">

                            <FlowPane hgap="14" vgap="12">

                                <VBox fx:id="departmentBox"
                                      spacing="7"
                                      prefWidth="300"
                                      visible="false"
                                      managed="false">

                                    <Label text="Department *"
                                           styleClass="field-label"/>

                                    <ComboBox fx:id="departmentComboBox"
                                              promptText="Select department"
                                              maxWidth="Infinity"/>
                                </VBox>

                                <VBox fx:id="batchBox"
                                      spacing="7"
                                      prefWidth="300"
                                      visible="false"
                                      managed="false">

                                    <Label text="Batch *"
                                           styleClass="field-label"/>

                                    <ComboBox fx:id="batchComboBox"
                                              promptText="Select batch"
                                              maxWidth="Infinity"/>
                                </VBox>
                            </FlowPane>

                            <GridPane hgap="14" vgap="14" minWidth="0">

                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>

                                    <ColumnConstraints percentWidth="50"
                                                       minWidth="0"
                                                       hgrow="ALWAYS"/>
                                </columnConstraints>

                                <children>
                                    <VBox spacing="7"
                                          minWidth="0"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="0">

                                        <Label text="Username *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="usernameField"
                                                   promptText="Enter username"
                                                   minWidth="0"/>
                                    </VBox>

                                    <VBox spacing="7"
                                          minWidth="0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="0">

                                        <Label text="Password"
                                               styleClass="field-label"/>

                                        <StackPane>
                                            <PasswordField fx:id="passwordField"
                                                           promptText="At least 8 characters"
                                                           minWidth="0"/>

                                            <TextField fx:id="visiblePasswordField"
                                                       promptText="At least 8 characters"
                                                       visible="false"
                                                       managed="false"
                                                       minWidth="0"/>
                                        </StackPane>

                                        <CheckBox fx:id="showPasswordCheckBox"
                                                  text="Show password"/>
                                    </VBox>

                                    <VBox spacing="7"
                                          minWidth="0"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="1">

                                        <Label text="First Name *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="firstNameField"
                                                   promptText="Enter first name"
                                                   minWidth="0"/>
                                    </VBox>

                                    <VBox spacing="7"
                                          minWidth="0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="1">

                                        <Label text="Last Name *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="lastNameField"
                                                   promptText="Enter last name"
                                                   minWidth="0"/>
                                    </VBox>

                                    <VBox spacing="7"
                                          minWidth="0"
                                          GridPane.columnIndex="0"
                                          GridPane.rowIndex="2"
                                          GridPane.columnSpan="2">

                                        <Label text="Email *"
                                               styleClass="field-label"/>

                                        <TextField fx:id="emailField"
                                                   promptText="name@example.com"
                                                   minWidth="0"/>
                                    </VBox>
                                </children>
                            </GridPane>

                            <Label text="New users need a password with at least 8 characters. When updating, leave it empty to keep the current password."
                                   wrapText="true"
                                   styleClass="muted"/>
                        </VBox>

                        <FlowPane hgap="10" vgap="10">

                            <Button fx:id="addButton"
                                    text="Add User"
                                    onAction="#addUser"
                                    styleClass="primary-button"
                                    disable="true"/>

                            <Button fx:id="updateButton"
                                    text="Save Changes"
                                    onAction="#updateUser"
                                    disable="true"/>

                            <Button fx:id="deleteButton"
                                    text="Delete User"
                                    onAction="#deleteUser"
                                    styleClass="danger-button"
                                    disable="true"/>

                            <Button fx:id="clearButton"
                                    text="New / Clear"
                                    onAction="#clearFields"/>

                            <Button fx:id="refreshButton"
                                    text="Refresh"
                                    onAction="#refreshUsers"/>
                        </FlowPane>

                        <HBox spacing="10" alignment="CENTER_LEFT">

                            <ProgressIndicator fx:id="progressIndicator"
                                               prefWidth="20"
                                               prefHeight="20"
                                               maxWidth="20"
                                               maxHeight="20"
                                               visible="false"
                                               managed="false"/>

                            <Label fx:id="messageLabel"
                                   wrapText="true"
                                   styleClass="message"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14"
                          minHeight="-Infinity"
                          styleClass="card">

                        <padding>
                            <Insets top="20"
                                    right="20"
                                    bottom="20"
                                    left="20"/>
                        </padding>

                        <HBox spacing="12" alignment="CENTER_LEFT">

                            <Label text="Registered Users"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="countLabel"
                                   text="0 users"
                                   styleClass="count-label"/>
                        </HBox>

                        <TextField fx:id="searchField"
                                   promptText="Search by ID, registration number, name, username, email or role..."/>

                        <TableView fx:id="usersTable"
                                   prefHeight="360"
                                   minHeight="200"
                                   minWidth="0"
                                   fixedCellSize="40">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="userIdColumn"
                                             text="User ID"
                                             minWidth="65"
                                             prefWidth="90"/>

                                <TableColumn fx:id="roleSpecificIdColumn"
                                             text="Role / Reg. ID"
                                             minWidth="90"
                                             prefWidth="120"/>

                                <TableColumn fx:id="usernameColumn"
                                             text="Username"
                                             minWidth="90"
                                             prefWidth="130"/>

                                <TableColumn fx:id="fullNameColumn"
                                             text="Full Name"
                                             minWidth="110"
                                             prefWidth="180"/>

                                <TableColumn fx:id="emailColumn"
                                             text="Email"
                                             minWidth="120"
                                             prefWidth="220"/>

                                <TableColumn fx:id="roleColumn"
                                             text="Role"
                                             minWidth="100"
                                             prefWidth="150"/>
                            </columns>

                            <placeholder>
                                <Label text="Loading users..."/>
                            </placeholder>
                        </TableView>

                        <Label text="Select a row to edit a user. Click New / Clear to create another account."
                               wrapText="true"
                               styleClass="muted"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>