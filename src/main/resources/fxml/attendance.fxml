<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fot.ams.controller.AttendanceController"
      stylesheets="@../css/technical-officer-attendance.css"
      styleClass="attendance-page"
      spacing="12">

    <VBox spacing="4">
        <Label text="Attendance Management"
               styleClass="attendance-title"/>

        <Label text="Record and review undergraduate attendance."
               styleClass="attendance-subtitle"/>
    </VBox>

    <!-- TG2070 - Compact session selection panel -->
    <VBox spacing="12"
          styleClass="attendance-panel">

        <Label text="Session Details"
               styleClass="attendance-section-title"/>

        <GridPane hgap="12" vgap="8">

            <columnConstraints>
                <ColumnConstraints percentWidth="27"
                                   minWidth="0"/>
                <ColumnConstraints percentWidth="17"
                                   minWidth="0"/>
                <ColumnConstraints percentWidth="17"
                                   minWidth="0"/>
                <ColumnConstraints percentWidth="16"
                                   minWidth="0"/>
                <ColumnConstraints percentWidth="23"
                                   minWidth="0"/>
            </columnConstraints>

            <VBox spacing="5"
                  minWidth="0"
                  GridPane.columnIndex="0">
                <Label text="Course"/>

                <ComboBox fx:id="courseComboBox"
                          promptText="Select course"
                          minWidth="0"
                          maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5"
                  minWidth="0"
                  GridPane.columnIndex="1">
                <Label text="Batch"/>

                <ComboBox fx:id="batchComboBox"
                          promptText="Select batch"
                          minWidth="0"
                          maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5"
                  minWidth="0"
                  GridPane.columnIndex="2">
                <Label text="Date"/>

                <DatePicker fx:id="sessionDatePicker"
                            promptText="Select date"
                            minWidth="0"
                            maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5"
                  minWidth="0"
                  GridPane.columnIndex="3">
                <Label text="Session Type"/>

                <ComboBox fx:id="sessionTypeComboBox"
                          promptText="Select type"
                          minWidth="0"
                          maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5"
                  minWidth="0"
                  GridPane.columnIndex="4">
                <Label text="Session"/>

                <ComboBox fx:id="sessionComboBox"
                          promptText="Select session"
                          minWidth="0"
                          maxWidth="Infinity"/>
            </VBox>

        </GridPane>

        <HBox spacing="10">
            <Button text="Load Students"
                    styleClass="attendance-primary-button"
                    onAction="#loadStudents"/>

            <Button text="Add Session"
                    styleClass="attendance-secondary-button"
                    onAction="#showAddSession"/>
        </HBox>

    </VBox>

    <!-- TG2070 - Give remaining space to student table -->
    <VBox spacing="10"
          minHeight="0"
          styleClass="attendance-panel"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Student Attendance"
                   styleClass="attendance-section-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="studentCountLabel"
                   text="0 students"
                   styleClass="attendance-subtitle"/>
        </HBox>

        <Label text="Attendance statuses: Present, Absent, Late, Excused"
               styleClass="attendance-subtitle"
               wrapText="true"/>

        <TableView fx:id="attendanceTable"
                   minHeight="140"
                   prefHeight="320"
                   maxHeight="Infinity"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="regNoColumn"
                             text="Registration No."
                             prefWidth="180"/>

                <TableColumn fx:id="studentNameColumn"
                             text="Student Name"
                             prefWidth="310"/>

                <TableColumn fx:id="statusColumn"
                             text="Attendance Status"
                             prefWidth="220"/>
            </columns>

            <placeholder>
                <Label text="Select a batch and session, then click Load Students."
                       wrapText="true"/>
            </placeholder>

        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button text="Mark All Present"
                    styleClass="attendance-secondary-button"
                    onAction="#markAllPresent"/>

            <Button text="Save Attendance"
                    styleClass="attendance-primary-button"
                    onAction="#saveAttendance"/>
        </HBox>

    </VBox>

</VBox>