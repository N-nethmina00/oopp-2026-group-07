<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="550.0" minWidth="800.0" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F3F6FA;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.LecturerController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0"
              style="-fx-background-color: #4c56cd; -fx-background-radius: 0 0 18 18;">
            <padding><Insets top="10" bottom="10" left="25" right="20"/></padding>
            <Label text="UMS" textFill="WHITE">
                <font><Font name="System Bold" size="22"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="3">
                <Label text="Welcome, Lecturer" textFill="WHITE">
                    <font><Font name="System Bold" size="13"/></font>
                </Label>
                <Label text="Lecturer Panel" textFill="#DCEEFF">
                    <font><Font size="11"/></font>
                </Label>
            </VBox>
            <StackPane minHeight="40" minWidth="40" prefHeight="40" prefWidth="40">
                <Circle fill="WHITE" radius="19"/>
                <Label text="L" textFill="#0078b9">
                    <font><Font name="System Bold" size="18"/></font>
                </Label>
            </StackPane>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="205.0" spacing="10">
            <padding><Insets top="18" bottom="15" left="12" right="12"/></padding>
            <VBox spacing="9" style="-fx-background-color: #4c56cd; -fx-background-radius: 18;"
                  VBox.vgrow="ALWAYS">
                <padding><Insets top="18" bottom="15" left="10" right="10"/></padding>
                <Button fx:id="dashboardBtn" text="Dashboard" onAction="#showDashboard" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: white; -fx-text-fill: #0078b9; -fx-background-radius: 8; -fx-font-weight: bold;"/>
                <Button fx:id="profileBtn" text="My Profile" onAction="#showProfile" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="coursesBtn" text="My Courses" onAction="#showCourses" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="materialsBtn" text="Course Materials" onAction="#showMaterials" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="marksBtn" text="Student Marks" onAction="#showMarks" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="studentsBtn" text="Undergraduate Details" onAction="#showStudents" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="eligibilityBtn" text="Exam Eligibility" onAction="#showEligibility" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="attendanceBtn" text="Attendance" onAction="#showAttendance" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="medicalsBtn" text="Medical Records" onAction="#showMedicals" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="gradesBtn" text="Grades &amp; GPA" onAction="#showGrades" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Button fx:id="noticesBtn" text="Notices" onAction="#showNotices" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8;"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Button text="Log Out" onAction="#logout" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                        style="-fx-background-color: #005B8F; -fx-text-fill: white; -fx-background-radius: 8;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #F3F6FA;">
            <content>
                <VBox spacing="18" fillWidth="true">
                    <padding><Insets top="30" bottom="25" left="20" right="25"/></padding>
                    <Label text="LECTURER DASHBOARD" textFill="#17324D">
                        <font><Font name="System Bold" size="22"/></font>
                    </Label>
                    <Label fx:id="pageTitle" text="Dashboard Overview" textFill="#17324D">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>
                    <Label fx:id="pageDescription" text="Manage your teaching activities and student records."
                           wrapText="true" textFill="#526174"/>
                    <VBox fx:id="contentArea" spacing="12" VBox.vgrow="ALWAYS"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
