<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.MedicalController"
            fitToWidth="true"
            stylesheets="@../css/technical-officer-medical.css"
            styleClass="medical-scroll">

    <content>
        <VBox spacing="20" styleClass="medical-page">

            <Label text="MEDICAL RECORDS"
                   styleClass="medical-title"/>

            <Label text="Maintain undergraduate medical records and view approval status."
                   wrapText="true"
                   styleClass="medical-subtitle"/>

            <VBox spacing="18" styleClass="medical-panel">

                <Label text="Medical Details"
                       styleClass="medical-section-title"/>

                <FlowPane hgap="20" vgap="15">

                    <VBox spacing="7">
                        <Label text="Registration Number"/>
                        <TextField fx:id="registrationField"
                                   promptText="Enter registration number"
                                   prefWidth="220"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Course"/>
                        <ComboBox fx:id="medicalCourseComboBox"
                                  promptText="Select course"
                                  prefWidth="220"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Medical Date"/>
                        <DatePicker fx:id="medicalDatePicker"
                                    promptText="Select date"
                                    prefWidth="180"/>
                    </VBox>

                </FlowPane>

                <VBox spacing="7">
                    <Label text="Reason"/>
                    <TextArea fx:id="medicalReasonArea"
                              promptText="Enter the medical reason"
                              wrapText="true"
                              prefRowCount="3"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button text="Clear"
                            styleClass="medical-secondary-button"

                                onAction="#clearForm"/>

                    <Button text="Save Medical"
                            styleClass="medical-primary-button"
                            onAction="#saveMedical"/>
                </HBox>

            </VBox>

            <VBox spacing="18" styleClass="medical-panel">

                <Label text="Medical Records"
                       styleClass="medical-section-title"/>

                <FlowPane hgap="12" vgap="12">

                    <TextField fx:id="medicalSearchField"
                               promptText="Search by registration number"
                               prefWidth="250"/>

                    <ComboBox fx:id="medicalStatusFilter"
                              promptText="All statuses"
                              prefWidth="180"/>

                    <Button text="Search"
                            styleClass="medical-primary-button"
                            onAction="#loadMedicalRecords"/>

                </FlowPane>

                <TableView fx:id="medicalTable"
                           prefHeight="260">

                    <columns>
                        <TableColumn fx:id="medicalIdColumn"
                                     text="Medical ID"
                                     prefWidth="90"/>

                        <TableColumn fx:id="registrationColumn"
                                     text="Registration No."
                                     prefWidth="150"/>

                        <TableColumn fx:id="courseColumn"
                                     text="Course"
                                     prefWidth="130"/>

                        <TableColumn fx:id="medicalDateColumn"
                                     text="Medical Date"
                                     prefWidth="120"/>

                        <TableColumn fx:id="reasonColumn"
                                     text="Reason"
                                     prefWidth="200"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="110"/>
                    </columns>

                    <placeholder>
                        <Label text="No medical records loaded."/>
                    </placeholder>

                </TableView>
                <!-- TG2070 - Update selected medical record status -->
                <HBox alignment="CENTER_RIGHT" spacing="12">

                    <Label text="Selected Record Status"/>

                    <ComboBox fx:id="medicalUpdateStatusComboBox"
                              promptText="Select status"
                              prefWidth="180"/>

                    <Button text="Update Status"
                            styleClass="medical-primary-button"
                            onAction="#updateMedicalStatus"/>

                </HBox>

                <Label text="Approval statuses: Pending, Approved, Rejected"
                       styleClass="medical-subtitle"/>

            </VBox>

            <Label text="New medical records are saved with Pending status."
                   wrapText="true"
                   styleClass="medical-subtitle"/>

        </VBox>
    </content>

</ScrollPane>