<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<!--
    Main Student Portal layout.
    Contains the header, sidebar, content area, and footer.
    Student pages are loaded dynamically into contentArea.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fot.ams.controller.StudentLayoutController"
            stylesheets="@../css/student-layout.css"
            styleClass="root-pane"
            prefWidth="1100"
            prefHeight="680"
            minWidth="900"
            minHeight="600">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox styleClass="top-bar"
              alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="70"
              minHeight="70">

            <!-- Application name -->
            <Label text="UMS" styleClass="top-brand"/>

            <!-- Push student details to the right -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Logged-in student name and role -->
            <VBox alignment="CENTER_RIGHT" spacing="3">

                <Label fx:id="lblUserName"
                       text="Welcome, Student"
                       styleClass="top-user-name"/>

                <Label fx:id="lblUserRole"
                       text="Undergraduate"
                       styleClass="top-user-role"/>

            </VBox>

            <!--
                Student header avatar.
                Displays the saved profile photo when available.
                Otherwise, displays the student's first letter.
                Clicking this avatar opens My Profile.
            -->
            <StackPane styleClass="avatar"
                       prefWidth="50"
                       prefHeight="50"
                       minWidth="50"
                       minHeight="50"
                       maxWidth="50"
                       maxHeight="50"
                       onMouseClicked="#openProfile">

                <!-- Default avatar letter -->
                <Label fx:id="lblAvatar"
                       text="S"
                       mouseTransparent="true"/>

                <!-- Saved student profile image -->
                <ImageView fx:id="imgHeaderAvatar"
                           fitWidth="46"
                           fitHeight="46"
                           preserveRatio="false"
                           mouseTransparent="true"/>

            </StackPane>

        </HBox>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar-wrap"
              prefWidth="200"
              minWidth="200"
              maxWidth="200">

            <VBox styleClass="sidebar"
                  spacing="6"
                  VBox.vgrow="ALWAYS">

                <!-- Student navigation buttons -->
                <VBox fx:id="navBox" spacing="6">

                    <Button text="Dashboard"
                            userData="student-dashboard"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="My Courses"
                            userData="student-courses"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Attendance"
                            userData="student-attendance"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="CA / Marks"
                            userData="student-marks"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Semester Results"
                            userData="student-results"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Medical"
                            userData="student-medical"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Course Materials"
                            userData="student-materials"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="Notices"
                            userData="student-notices"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                    <Button text="My Profile"
                            userData="student-profile"
                            onAction="#navigate"
                            styleClass="nav-button"
                            maxWidth="Infinity"/>

                </VBox>

                <!-- Push logout button to bottom -->
                <Region VBox.vgrow="ALWAYS"/>

                <!-- Student logout button -->
                <Button text="Log Out"
                        onAction="#handleLogout"
                        styleClass="logout-button"
                        maxWidth="Infinity"/>

            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <BorderPane>

            <center>
                <!-- Selected student page loads here -->
                <StackPane fx:id="contentArea"/>
            </center>

            <bottom>
                <!-- Student Portal footer -->
                <Label text="University Management System  •  Student Portal"
                       styleClass="footer-text"
                       maxWidth="Infinity"
                       alignment="CENTER"/>
            </bottom>

        </BorderPane>
    </center>

</BorderPane>
