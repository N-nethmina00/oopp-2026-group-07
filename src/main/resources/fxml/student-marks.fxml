<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fot.ams.controller.StudentMarksController"
      stylesheets="@../css/student-marks.css" styleClass="page" spacing="20">

    <VBox spacing="4">
        <Label text="CA / MARKS" styleClass="page-heading"/>
        <Label text="Your CA eligibility for each enrolled course" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="section-card" spacing="14" VBox.vgrow="ALWAYS">
        <Label text="CA Eligibility" styleClass="section-title"/>
        <TableView fx:id="tblMarks" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCode" text="Code"/>
                <TableColumn fx:id="colName" text="Course"/>
                <TableColumn fx:id="colEligibility" text="CA Eligibility"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
