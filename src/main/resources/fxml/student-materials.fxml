<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fot.ams.controller.StudentMaterialsController"
      stylesheets="@../css/student-materials.css" styleClass="page" spacing="20">

    <VBox spacing="4">
        <Label text="COURSE MATERIALS" styleClass="page-heading"/>
        <Label text="Lecture notes, slides and other resources" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12" alignment="BOTTOM_LEFT">
        <VBox spacing="6">
            <Label text="COURSE" styleClass="field-label"/>
            <ComboBox fx:id="cmbCourse" prefWidth="280" styleClass="form-control"/>
        </VBox>
    </HBox>

    <VBox styleClass="section-card" spacing="14" VBox.vgrow="ALWAYS">
        <Label text="Materials" styleClass="section-title"/>
        <TableView fx:id="tblMaterials" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCourse" text="Course"/>
            <TableColumn fx:id="colTitle" text="Title"/>
            <TableColumn fx:id="colType" text="Type"/>
            <TableColumn fx:id="colUploaded" text="Uploaded"/>
            <TableColumn fx:id="colAction" text="Action" sortable="false"/>
        </columns>
        </TableView>
    </VBox>
</VBox>
