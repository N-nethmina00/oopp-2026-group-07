<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fot.ams.controller.StudentMedicalController"
      stylesheets="@../css/student-medical.css" styleClass="page" spacing="20">

    <VBox spacing="4">
        <Label text="MEDICAL APPLICATION" styleClass="page-heading"/>
        <Label text="Submit a medical for a missed session or exam" styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="section-card" spacing="14">
        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="COURSE" styleClass="field-label"/>
                <ComboBox fx:id="cmbCourse" maxWidth="Infinity" styleClass="form-control"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="MEDICAL DATE" styleClass="field-label"/>
                <DatePicker fx:id="dpDate" maxWidth="Infinity" styleClass="form-control"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="REASON" styleClass="field-label"/>
            <TextArea fx:id="txtReason" prefRowCount="3" wrapText="true"
                      promptText="Explain the reason" styleClass="form-control"/>
        </VBox>

        <VBox spacing="6">
            <Label text="UPLOAD MEDICAL DOCUMENT (OPTIONAL)" styleClass="field-label"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Choose File" onAction="#handleChooseFile" styleClass="secondary-button"/>
                <Label fx:id="lblFile" text="No file selected" styleClass="hint-label"/>
            </HBox>
        </VBox>

        <Label fx:id="lblMessage" managed="false" visible="false"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Submit" onAction="#handleSubmit" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <VBox styleClass="section-card" spacing="14" VBox.vgrow="ALWAYS">
        <Label text="My previous applications" styleClass="section-title"/>
        <TableView fx:id="tblMedical" prefHeight="220" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date"/>
            <TableColumn fx:id="colCourse" text="Course"/>
            <TableColumn fx:id="colReason" text="Reason"/>
            <TableColumn fx:id="colStatus" text="Status"/>
        </columns>
        </TableView>
    </VBox>
</VBox>
