<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fot.ams.controller.StudentNoticesController"
      stylesheets="@../css/student-notices.css" styleClass="page" spacing="20">

    <VBox spacing="4">
        <Label text="NOTICES" styleClass="page-heading"/>
        <Label text="Latest announcements from the university" styleClass="page-subtitle"/>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
        <VBox fx:id="noticeBox" spacing="14"/>
    </ScrollPane>
</VBox>
