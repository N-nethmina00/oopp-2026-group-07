<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="dashboardRoot"
            fx:controller="com.fot.ams.controller.TechnicalOfficerController"
            stylesheets="@../css/technical-officer.css"
            prefWidth="1200"
            prefHeight="750">

    <top>
        <HBox styleClass="header">
            <Label text="University Management System"
                   styleClass="header-title"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar">

            <Label text="UMS"
                   styleClass="logo"/>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button, active"
                    onAction="#showDashboard"/>

            <Button text="Students"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Attendance"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#showAttendance"/>

            <Button text="Sessions"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Course Materials"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Timetable"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Medical Records"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Notices"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Profile"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Logout"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox styleClass="content">

                    <Label text="Technical Officer Dashboard"
                           styleClass="page-title"/>

                    <FlowPane styleClass="cards">

                        <VBox styleClass="card">
                            <Label text="Students"
                                   styleClass="card-title"/>

                            <Label fx:id="studentCountLabel"
                                   text="420"
                                   styleClass="card-value"/>

                            <Label text="Department"
                                   styleClass="card-description"/>
                        </VBox>

                        <VBox styleClass="card">
                            <Label text="Sessions"
                                   styleClass="card-title"/>

                            <Label fx:id="sessionCountLabel"
                                   text="36"
                                   styleClass="card-value"/>

                            <Label text="This week"
                                   styleClass="card-description"/>
                        </VBox>

                        <VBox styleClass="card">
                            <Label text="Attendance"
                                   styleClass="card-title"/>

                            <Label fx:id="attendanceCountLabel"
                                   text="12"
                                   styleClass="card-value"/>

                            <Label text="Pending"
                                   styleClass="card-description"/>
                        </VBox>

                        <VBox styleClass="card">
                            <Label text="Materials"
                                   styleClass="card-title"/>

                            <Label fx:id="materialCountLabel"
                                   text="24"
                                   styleClass="card-value"/>

                            <Label text="Uploaded"
                                   styleClass="card-description"/>
                        </VBox>

                    </FlowPane>

                    <Label text="Quick Actions"
                           styleClass="section-title"/>

                    <FlowPane styleClass="quick-actions">

                        <Button text="Record Attendance"
                                styleClass="action-button"
                                onAction="#showAttendance"/>

                        <Button text="Manage Session"
                                styleClass="action-button"/>

                        <Button text="View Medical"
                                styleClass="action-button"/>

                    </FlowPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>